<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BetterConsoles.Colors" Version="1.1.1" />
    <PackageVersion Include="BetterConsoles.Core" Version="1.2.0" />
    <PackageVersion Include="BetterConsoleTables" Version="1.1.3" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.5-beta1" />
  </ItemGroup>
</Project>